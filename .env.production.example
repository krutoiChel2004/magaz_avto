APP_DOMAIN=example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=mcm_store
POSTGRES_USER=mcm_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_HEX
DATABASE_URL=postgresql+asyncpg://mcm_user:CHANGE_ME_GENERATE_HEX@postgres:5432/mcm_store

JWT_SECRET=CHANGE_ME_GENERATE_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
FRONTEND_URL=https://example.com

API_URL=http://api:8000/api
NEXT_PUBLIC_API_URL=/api

S3_ENABLED=true
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=/s3
# Для текущего compose можно использовать те же значения, что и у MINIO_ROOT_USER/MINIO_ROOT_PASSWORD.
S3_ACCESS_KEY=CHANGE_ME_GENERATE_HEX
S3_SECRET_KEY=CHANGE_ME_GENERATE_HEX
S3_BUCKET=mcm-content
S3_REGION=us-east-1
MINIO_ROOT_USER=CHANGE_ME_GENERATE_HEX
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_HEX

RUN_MIGRATIONS=true
RUN_SEED=false
